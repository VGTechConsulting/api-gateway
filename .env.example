# Provider credentials for the gate (never committed; copy to .env).
# Clients use gateway keys (gk_...), never these.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Only needed if you enable the mock deployment for benchmarks:
# MOCK_API_KEY=any-non-empty-value
# Host ports for docker compose, if the defaults are taken on your machine:
# API_GATEWAY_HOST_PORT=8787      # the gate
# API_GATEWAY_UI_HOST_PORT=8789   # the read-only report UI
